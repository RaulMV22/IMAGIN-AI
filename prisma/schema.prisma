generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model GeneratedImage {
  id        Int      @id @default(autoincrement())
  prompt    String
  imageUrl  String
  createdAt DateTime @default(now())
}


model GeneratedVideo {
  id        Int      @id @default(autoincrement())
  prompt    String
  videoUrl  String
  createdAt DateTime @default(now())
}
